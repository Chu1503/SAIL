# SAIL repository exclusions

# -----------------------------------------------------------------------------
# Operating-system and editor metadata
# -----------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini

.idea/
.vscode/
*.iml
*.swp
*.swo
*~

# -----------------------------------------------------------------------------
# Local configuration, credentials, and signing material
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.*.example

*.jks
*.keystore
*.p12
*.pfx
*.pem

# -----------------------------------------------------------------------------
# Python backend
# -----------------------------------------------------------------------------
backend/venv/
backend/.venv/
backend/env/

__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/

.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# -----------------------------------------------------------------------------
# Next.js / Node frontend
# -----------------------------------------------------------------------------
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/coverage/
frontend/.turbo/
frontend/.vercel/
frontend/*.tsbuildinfo
frontend/next-env.d.ts

.npm/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/

# -----------------------------------------------------------------------------
# Android / Gradle / Capacitor generated output
# -----------------------------------------------------------------------------
frontend/android/.gradle/
frontend/android/**/build/
frontend/android/local.properties
frontend/android/captures/
frontend/android/.cxx/
frontend/android/.externalNativeBuild/

frontend/android/app/src/main/assets/public/
frontend/android/app/src/main/assets/capacitor.config.json
frontend/android/app/src/main/assets/capacitor.plugins.json
frontend/android/app/src/main/res/xml/config.xml

*.apk
*.aab
*.aar
*.dex
*.class
*.hprof

# -----------------------------------------------------------------------------
# Logs, reports, and temporary files
# -----------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

.cache/
.tmp/
tmp/
temp/

# The production segmentation checkpoint in backend/models is intentionally
# versioned so local, hosted, and Android-backed deployments use the same model.
